# Public client values from Supabase Project Settings > API.
# Never place a service-role key in an Expo app.
# Use development, staging, or production. Production also requires the real
# backend lock and both Supabase values to be supplied by the release environment.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_REQUIRE_REAL_BACKEND=false
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Stripe publishable keys are safe for the app; secret keys must stay server-side.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PAYMENTS_API_URL=
EXPO_PUBLIC_GIFTS_API_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.cloudflare.com:3478"]}]

# Public SDK key used only for client-side GIF search. Create a production app
# in the GIPHY developer dashboard; do not reuse a sample or another app's key.
EXPO_PUBLIC_GIPHY_API_KEY=

# Express/MySQL realtime + push providers. Secrets stay server-side.
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@destinyone.app
EXPO_PUSH_ACCESS_TOKEN=
PUSH_DISPATCH_SECRET=
WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.cloudflare.com:3478"]}]

# Server/CI-only Supabase deployment values. Never prefix these with
# EXPO_PUBLIC_ and never bundle them into the app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BASELINE_APPROVED=false

# Store-verification adapter used only by the verify-store-purchase Edge
# Function. It must validate Apple/Google receipts server-side and return the
# normalized response documented in docs/BILLING-AND-LAUNCH-ANALYTICS.md.
STORE_PURCHASE_VERIFIER_URL=
STORE_PURCHASE_VERIFIER_SECRET=
